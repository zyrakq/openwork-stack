# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, step-ca/.env.example, model-keys/.env.example, repo-sync/.env.example, step-ca-trust/.env.example

COMPOSE_PROJECT_NAME=openwork-stack

IMAGE_HOST=localhost/openwork-host:0.18.4
IMAGE_WEB=localhost/openwork-web:0.18.4

LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

# Container-internal port (server --port + healthcheck). The published host
# port lives in the forwarding overlay (OPENWORK_PUBLISH_PORT).
OPENWORK_PORT=8787

OPENWORK_APPROVAL_MODE=manual

# REQUIRED — server auth token; placeholder only, never commit a real value
OPENWORK_TOKEN=

# Provider model keys (optional passthrough; the model-keys extension documents them)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
VIRTUAL_HOST=openwork.example.com
OPENWORK_API_VHOST=openwork-api.example.com

VIRTUAL_PROTO=http

# LETSENCRYPT_HOST covers the UI vhost; the API vhost needs its own cert
# entry per the letsencrypt-manager's multi-vhost handling.
LETSENCRYPT_HOST=openwork.example.com

LETSENCRYPT_EMAIL=admin@example.com
# model-keys extension — AI provider API keys passed through to the openwork server.
# At least one working key is a Stage A gate prerequisite (DEPLOYMENT.md functional base):
# agent sessions cannot run without a provider credential.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# repo-sync extension (mutually exclusive with repo-local)

# Required: repository URL to clone into /workspace
REPO_SYNC_URL=

# Branch to track (default: main)
REPO_SYNC_BRANCH=main

# Directory under /workspace (default: basename of the URL)
REPO_SYNC_DIR_NAME=

# https credentials (token preferred, read-only; default user: x-access-token)
REPO_SYNC_TOKEN=
REPO_SYNC_USER=x-access-token

# Private key for ssh URLs (optional)
REPO_SYNC_SSH_KEY=

# Seconds between fast-forward pulls (default: 300)
REPO_SYNC_INTERVAL=300

# Sidecar image (default: alpine/git:latest)
REPO_SYNC_IMAGE=alpine/git:latest
# step-ca-trust extension (meaningful only with the step-ca environment;
# requires the external step-ca-data volume)

# Source of the step-ca root CA inside the container (read-only mount of the
# external step-ca-data volume, certs/ subpath)
STEP_CA_ROOT_CA_SRC=/step-ca-root/root_ca.crt

# Install target in the container trust store (copied here, then picked up
# by update-ca-certificates)
STEP_CA_ROOT_CA_FILE=/usr/local/share/ca-certificates/step-ca-root.crt

# Seconds to wait for the root CA to appear before failing (default: 60)
STEP_CA_WAIT_TIMEOUT=60