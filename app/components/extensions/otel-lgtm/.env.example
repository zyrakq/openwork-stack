# otel-lgtm extension (Grafana LGTM observability backend)

# Image override (default: published grafana/otel-lgtm all-in-one)
LGTM_IMAGE=docker.io/grafana/otel-lgtm:0.11.16

# Host port for the Grafana UI/API (Tempo/Loki/Prometheus are queried through it)
OPENWORK_GRAFANA_PUBLISH_PORT=3000

# OTLP exporter for the openwork server. Empty values fall back to the compose
# defaults, which point at the openwork-lgtm collector over the internal network.
# Upstream supports OTLP/HTTP protobuf only.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=
