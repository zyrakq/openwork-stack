COMPOSE_PROJECT_NAME=openwork-stack

IMAGE_HOST=localhost/openwork-host:0.18.4
IMAGE_WEB=localhost/openwork-web:0.18.4

LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

# Container-internal port (server --port + healthcheck). The published host
# port lives in the forwarding overlay (OPENWORK_PUBLISH_PORT).
OPENWORK_PORT=8787

OPENWORK_APPROVAL_MODE=manual

# REQUIRED — server auth token; placeholder only, never commit a real value
OPENWORK_TOKEN=

# Provider model keys (optional passthrough; the model-keys extension documents them)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
